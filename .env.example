# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
BOLTMIND_MODEL=claude-opus-5
# low / medium / high / xhigh / max —— 越高越聪明也越贵，日常用 high 够了
BOLTMIND_EFFORT=high
BOLTMIND_MAX_TOKENS=8000
# 每晚 AI 花费硬上限（美元）。到顶就停，剩下的公司留到下一轮，不会超支。
BOLTMIND_NIGHTLY_BUDGET_USD=5.0

# ---------------------------------------------------------------------------
# 流水线
# ---------------------------------------------------------------------------
BOLTMIND_DATA_DIR=./data
# 一晚最多处理几家公司
BOLTMIND_MAX_COMPANIES=20
# 高优先级的分数门槛
BOLTMIND_HIGH_PRIORITY_THRESHOLD=70
# 爬虫：遵守 robots.txt、每次请求间隔、单站最多抓几页
BOLTMIND_RESPECT_ROBOTS=true
BOLTMIND_CRAWL_DELAY=1.0
BOLTMIND_CRAWL_MAX_PAGES=5
BOLTMIND_CRAWL_TIMEOUT=15
BOLTMIND_USER_AGENT=BoltMindBot/0.1 (+https://your-site.com/bot; B2B research)

# ---------------------------------------------------------------------------
# 我方公司信息 —— 会写进提示词，AI 靠这些生成有事实依据的开发信
# ---------------------------------------------------------------------------
SELLER_COMPANY=TC-Smart Link / 永年紧固件
SELLER_WEBSITE=
SELLER_ONE_LINER=河北永年紧固件工厂，标准件与非标件生产商
SELLER_PRODUCTS=高强度螺母、外六角螺栓、法兰螺母、平垫圈、弹簧垫圈（M4-M10 为主）
SELLER_DIFFERENTIATORS=自有工厂直供、可做非标定制、小批量起订、DIN/ISO/ANSI 标准件齐全
SELLER_CERTIFICATIONS=ISO 9001
SELLER_MOQ=小批量可谈
SELLER_LEAD_TIME=常规品 15-25 天
SELLER_SENDER_NAME=
SELLER_SENDER_TITLE=Sales Manager
SELLER_SENDER_PHONE=

# ---------------------------------------------------------------------------
# 发信（SMTP）
# ---------------------------------------------------------------------------
# ⚠️ 总开关。false 时后台只能导出 .eml 手动发，任何代码路径都发不出邮件。
# 建议前两周保持 false，用 .eml 手动发，确认草稿质量后再打开。
BOLTMIND_ALLOW_SEND=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# 收信（IMAP）—— 用来把客户回复拉进系统做意图分析
# ---------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
