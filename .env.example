# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
RADAR_MODEL=claude-opus-5
# low / medium / high / xhigh / max —— 越高越聪明也越贵，日常用 high 够了
RADAR_EFFORT=high
RADAR_MAX_TOKENS=8000
# 每晚 AI 花费硬上限（美元）。到顶就停，剩下的公司留到下一轮，不会超支。
RADAR_NIGHTLY_BUDGET_USD=5.0

# ---------------------------------------------------------------------------
# 流水线
# ---------------------------------------------------------------------------
RADAR_DATA_DIR=./data
# 一晚最多处理几家公司
RADAR_MAX_COMPANIES=20
# 高优先级的分数门槛
RADAR_HIGH_PRIORITY_THRESHOLD=70
# 爬虫：遵守 robots.txt、每次请求间隔、单站最多抓几页
RADAR_RESPECT_ROBOTS=true
RADAR_CRAWL_DELAY=1.0
RADAR_CRAWL_MAX_PAGES=5
RADAR_CRAWL_TIMEOUT=15
RADAR_USER_AGENT=CustomsRadarBot/0.1 (+https://your-site.com/bot; B2B research)

# ---------------------------------------------------------------------------
# 我方公司信息 —— 会写进提示词，AI 靠这些生成有事实依据的开发信
# ---------------------------------------------------------------------------
SELLER_COMPANY=TC-Smart Link / 永年紧固件
SELLER_WEBSITE=
SELLER_ONE_LINER=河北永年紧固件工厂，标准件与非标件生产商
SELLER_PRODUCTS=高强度螺母、外六角螺栓、法兰螺母、平垫圈、弹簧垫圈（M4-M10 为主）
SELLER_DIFFERENTIATORS=自有工厂直供、可做非标定制、小批量起订、DIN/ISO/ANSI 标准件齐全
SELLER_CERTIFICATIONS=ISO 9001
SELLER_MOQ=小批量可谈
SELLER_LEAD_TIME=常规品 15-25 天
SELLER_SENDER_NAME=
SELLER_SENDER_TITLE=Sales Manager
SELLER_SENDER_PHONE=

# ---------------------------------------------------------------------------
# 邮箱发现（多源聚合）—— 免费来源默认开，付费/联网来源填 key 才启用
# ---------------------------------------------------------------------------
# 官网抓取、按人名生成邮箱模式：始终开，免费、离线，无需配置。
# WHOIS：系统有 whois 命令就自动用，没有就跳过。不想用设 false。
DISCOVER_WHOIS=true
# Hunter.io —— B2B 找邮箱行业标配，直接给人名+职位+置信度。强烈建议配。
HUNTER_API_KEY=
# 搜索引擎（走官方 API，不爬结果页）：serpapi / bing / brave
SEARCH_ENGINE=
SEARCH_API_KEY=
DISCOVER_TIMEOUT=12
# 校验：MX 查询便宜安全，默认开。
DISCOVER_VERIFY_MX=true
# ⚠️ SMTP 探测默认关。开了能确认邮箱真假，但频繁探测会让你的发信 IP 被标记成
# 垃圾源，反而伤自己的开发信送达率（等于自己把自己端了）。要开就限速。
DISCOVER_VERIFY_SMTP=false
DISCOVER_VERIFY_SMTP_MIN_CONFIDENCE=40
DISCOVER_VERIFY_SMTP_MAX=20

# ---------------------------------------------------------------------------
# 发信（SMTP）
# ---------------------------------------------------------------------------
# ⚠️ 总开关。false 时后台只能导出 .eml 手动发，任何代码路径都发不出邮件。
# 建议前两周保持 false，用 .eml 手动发，确认草稿质量后再打开。
RADAR_ALLOW_SEND=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# 收信（IMAP）—— 用来把客户回复拉进系统做意图分析
# ---------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
